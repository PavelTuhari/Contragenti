# Виртуальное окружение
.venv/
venv/

# Python
__pycache__/
*.py[cod]
*.egg-info/

# Локальная база данных пользователя (не выкладывается)
companies.db
companies.db-journal

# Параметры подключения к una.md (содержат пароль) — не выкладываются
tms_config.json
hub_config.json
goods_config.json
goods_local.db

# Данные хаба: принятые пакеты и реестр заданий
hub_data/

# Delphi CRM: сборочные артефакты и локальные данные.
# ContragentiCRM.exe — исключение: собранный бинарник коммитится намеренно,
# чтобы MSI-инсталлятор (setup.py) мог включить Demo CRM без установленного
# RAD Studio/dcc32 на машине, которая собирает MSI.
crm_delphi/dcu/
crm_delphi/*.exe
!crm_delphi/ContragentiCRM.exe
crm_delphi/*.RES
crm_delphi/*.res
crm_delphi/*.dcu
crm_delphi/clients.db
crm_delphi/crm.ini

# Секреты развёртывания
deploy/.env
deploy/hub_config.json
deploy/instantclient-*.zip

# Экспортированные данные
*.xlsx
*.csv
card.xml
export/

# macOS
.DS_Store

# Видео-презентации (хранятся локально, вне репозитория)
*.mov
*.mp4

# Локальные настройки инструментов
.claude/settings.local.json

# Архивы и временные файлы
*.zip
*.log

# Собранные дистрибутивы (cx_Freeze / MSI) — не хранятся в репозитории
build/
dist/
crm_delphi/build.log
crm_delphi/gui_test.log
crm_delphi/shots_gui/test_clients.db