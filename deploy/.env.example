# Параметры хаба. Скопируйте в deploy/.env и заполните.
# Файл .env содержит пароль — в репозиторий не коммитится.

# Подключение к una.md (Oracle)
TMS_DSN=192.168.0.24:1521/clouddev.world
TMS_USER=paralax
TMS_PASSWORD=

# Каталог Oracle Instant Client внутри контейнера
ORACLE_CLIENT_DIR=/opt/oracle/instantclient

# Каталог данных хаба (том контейнера)
HUB_DATA_DIR=/data
